<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capture_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/capture_library" style="@style/CaptureIconButton" android:src="@drawable/ic_back" android:contentDescription="@string/library" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/capture_browser" android:textSize="@dimen/pk_body_text" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@+id/capture_save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/pk_touch_target" android:text="@string/save_page" android:textAllCaps="false" android:textSize="@dimen/pk_body_text" />
        <ImageButton android:id="@+id/capture_menu" style="@style/CaptureIconButton" android:src="@drawable/ic_more" android:contentDescription="@string/browser_options" />
    </LinearLayout>
    <TextView android:id="@+id/capture_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/pk_touch_target" android:gravity="center_vertical" android:paddingStart="@dimen/pk_inset" android:paddingEnd="@dimen/pk_inset" android:textSize="@dimen/pk_caption_text" android:textColor="@color/pk_ink" android:textDirection="ltr" android:maxLines="2" android:ellipsize="end" android:background="@color/pk_canvas" android:contentDescription="@string/show_full_address" />
    <TextView android:id="@+id/capture_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/pk_inset" android:paddingEnd="@dimen/pk_inset" android:paddingTop="@dimen/pk_small_inset" android:paddingBottom="@dimen/pk_small_inset" android:text="@string/capture_hint" android:textSize="@dimen/pk_caption_text" android:textColor="@color/pk_muted" android:accessibilityLiveRegion="polite" />
    <WebView android:id="@+id/capture_web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
